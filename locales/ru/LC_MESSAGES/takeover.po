msgid "CURRENT LANGUAGE"
msgstr "ТЕКУЩИЙ ЯЗЫК"
msgid "Many voices."
msgstr "Много голосов."
msgid "One shared space."
msgstr "Одно общее пространство."
msgid "A small laboratory for testing how TAKE OVER speaks across languages before translated copy enters the wider project."
msgstr "Небольшая лаборатория, где мы проверяем, как TAKE OVER звучит на разных языках, прежде чем переводы войдут в основной проект."
msgid "CONTEXT"
msgstr "КОНТЕКСТ"
msgid "Translation keeps its place"
msgstr "Перевод сохраняет своё место"
msgid "Messages are translated in context, while the project structure and source data remain unchanged."
msgstr "Сообщения переводятся с учётом контекста, а структура проекта и исходные данные остаются неизменными."
msgid "Plural-form test"
msgstr "Проверка форм множественного числа"
msgid "%(count)d open door"
msgid_plural "%(count)d open doors"
msgstr[0] "%(count)d открытая дверь"
msgstr[1] "%(count)d открытые двери"
msgstr[2] "%(count)d открытых дверей"
msgid "This sentence changes through the catalogue’s plural rules, not a UI-only conditional."
msgstr "Это предложение изменяется по правилам множественного числа из каталога, а не по условию только в интерфейсе."
msgid "SOURCE COPY: ENGLISH"
msgstr "ИСХОДНЫЙ ТЕКСТ: АНГЛИЙСКИЙ"
msgid "CATALOGUE: GNU GETTEXT"
msgstr "КАТАЛОГ: GNU GETTEXT"
